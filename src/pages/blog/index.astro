---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PostPreview from '../../components/PostPreview.astro';
const posts = (await getCollection('posts')).filter(({ data }) => !data.draft).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Writing — Shaul Kim"><Header /><main class="container section"><p class="eyebrow">Notes from the work</p><h1>Writing</h1><div class="list">{posts.map(({ data, id }) => <PostPreview {...data} slug={id} />)}</div></main></BaseLayout>
<style lang="scss">h1 { margin: 0 0 var(--space-12); font-family: var(--font-display); font-size: var(--text-display); font-weight: 400; letter-spacing: -.04em; }.list { border-bottom: 1px solid var(--color-line); }</style>
