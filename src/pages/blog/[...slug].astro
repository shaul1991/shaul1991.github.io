---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ArticleNavigation from '../../components/ArticleNavigation.astro';
import SeriesBadge from '../../components/SeriesBadge.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const publishedAt = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(post.data.publishedAt);
const contextGroups = [{
  label: '글 목차',
  items: headings
    .filter(({ depth }) => depth === 2)
    .map(({ slug, text }) => ({ href: `#${slug}`, label: text })),
}];
const seriesPosts = post.data.series
  ? (await getCollection('posts'))
      .filter(({ data }) => data.series === post.data.series)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const seriesIndex = seriesPosts.findIndex(({ id }) => id === post.id);
const previousPost = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : undefined;
const nextPost = seriesIndex >= 0 ? seriesPosts[seriesIndex + 1] : undefined;
const seriesPosition = post.data.series && post.data.seriesOrder
  ? `${post.data.seriesOrder}/${seriesPosts.length}`
  : undefined;
---

<BaseLayout title={`${post.data.title} — Shaul Kim`} description={post.data.description}>
  <Header contextGroups={contextGroups} />
  <main>
    <article>
      <header class="article-header container">
        <a class="back-link" href="/blog">← 글 목록</a>
        <div class="article-meta" aria-label="글 정보">
          {post.data.series ? <SeriesBadge label={post.data.series} position={seriesPosition} /> : <span>작업 방식</span>}
          <span>{publishedAt}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        <div class="tags" aria-label="글 태그">{post.data.tags.map((tag) => <span>#{tag}</span>)}</div>
      </header>
      <div class="article-shell container">
        <div class="article-body"><Content /></div>
      </div>
    </article>
  </main>
  <ArticleNavigation
    previous={previousPost ? { href: `/blog/${previousPost.id}`, title: previousPost.data.title } : undefined}
    next={nextPost ? { href: `/blog/${nextPost.id}`, title: nextPost.data.title } : undefined}
  />
</BaseLayout>

<style lang="scss">
  .article-header { max-width: 64rem; padding-block: clamp(5rem, 12vw, 9rem) var(--space-16); }
  .back-link { display: inline-block; margin-bottom: var(--space-12); color: var(--color-muted); font-size: var(--text-sm); font-weight: 800; text-decoration: none; }
  .article-meta { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; color: var(--color-muted); font-size: var(--text-xs); font-weight: 700; }
  h1 { max-width: 58rem; margin: var(--space-4) 0 0; font-family: var(--font-display); font-size: clamp(3rem, 8vw, 6.75rem); font-weight: 400; letter-spacing: -.055em; line-height: .96; }
  .lead { max-width: 46rem; margin: var(--space-8) 0 0; color: var(--color-muted); font-size: var(--text-lg); line-height: 1.75; }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-8); color: var(--color-accent-strong); font-size: var(--text-xs); font-weight: 800; }
  .article-shell { border-top: 1px solid var(--color-line); }
  .article-body { max-width: 50rem; padding-block: var(--space-16) var(--space-24); margin-inline: auto; }
  .article-body :global(p), .article-body :global(li) { color: var(--color-muted); font-size: clamp(1rem, 1.4vw, 1.125rem); line-height: 1.9; }
  .article-body :global(p) { margin: 0 0 var(--space-6); }
  .article-body :global(h2) { scroll-margin-top: 7rem; margin: var(--space-16) 0 var(--space-6); font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 400; letter-spacing: -.035em; line-height: 1.08; }
  .article-body :global(h2:first-child) { margin-top: 0; }
  .article-body :global(ul) { padding-left: 1.25rem; margin: var(--space-6) 0 var(--space-8); }
  .article-body :global(li + li) { margin-top: var(--space-2); }
  .article-body :global(strong) { color: var(--color-ink); }
  .article-body :global(.process-flow) { margin: var(--space-8) 0 var(--space-12); }
  .article-body :global(.process-flow ol) {
    display: grid;
    padding: 0;
    margin: 0;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
  }
  .article-body :global(.process-flow--5 ol) { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .article-body :global(.process-flow li) {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    margin: 0;
    border-inline-end: 1px solid var(--color-line);
  }
  .article-body :global(.process-flow li:last-child) { border-inline-end: 0; }
  .article-body :global(.process-flow li:not(:last-child)::after) {
    position: absolute;
    z-index: 1;
    top: 50%;
    right: 0;
    color: var(--color-accent-strong);
    content: '→';
    font-weight: 800;
    transform: translate(60%, -50%);
  }
  .article-body :global(.process-flow li > span) { font-size: var(--text-lg); line-height: 1; }
  .article-body :global(.process-flow li > strong) { font-size: var(--text-sm); }
  .article-body :global(.process-flow li > small) { color: var(--color-muted); font-size: var(--text-xs); line-height: 1.5; }
  .article-body :global(pre) { overflow-x: auto; padding: var(--space-6); margin: var(--space-12) 0; color: var(--color-ink); background: var(--color-surface-raised); border: 1px solid var(--color-line); border-radius: var(--radius-md); font-size: var(--text-sm); line-height: 1.8; }
  .article-body :global(code) { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  @media (max-width: 38rem) {
    .article-header { padding-block: var(--space-16) var(--space-12); }
    .article-body { padding-block: var(--space-12) var(--space-24); }
    .article-body :global(h2) { margin-top: var(--space-16); }
    .article-body :global(.process-flow ol) { grid-template-columns: 1fr; }
    .article-body :global(.process-flow li) {
      grid-template-areas: 'icon title' 'icon description';
      grid-template-columns: 2rem minmax(0, 1fr);
      align-items: center;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .article-body :global(.process-flow li:last-child) { border-bottom: 0; }
    .article-body :global(.process-flow li:not(:last-child)::after) {
      top: auto;
      right: 50%;
      bottom: 0;
      content: '↓';
      transform: translate(50%, 60%);
    }
    .article-body :global(.process-flow li > span) { grid-area: icon; }
    .article-body :global(.process-flow li > strong) { grid-area: title; }
    .article-body :global(.process-flow li > small) { grid-area: description; }
    .article-body :global(pre) { padding: var(--space-4); font-size: var(--text-xs); }
  }
</style>
