---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleNavigation from '../components/ArticleNavigation.astro';
import PostPreview from '../components/PostPreview.astro';
import SeriesBadge from '../components/SeriesBadge.astro';
import SeriesFilter from '../components/SeriesFilter.astro';
import SiteFooter from '../components/SiteFooter.astro';

const colors = [
  { name: '배경', token: '--color-surface', value: 'var(--color-surface)' },
  { name: '올라온 배경', token: '--color-surface-raised', value: 'var(--color-surface-raised)' },
  { name: '본문', token: '--color-ink', value: 'var(--color-ink)' },
  { name: '보조 본문', token: '--color-muted', value: 'var(--color-muted)' },
  { name: '구분선', token: '--color-line', value: 'var(--color-line)' },
  { name: '강조', token: '--color-accent', value: 'var(--color-accent)' },
  { name: '강한 강조', token: '--color-accent-strong', value: 'var(--color-accent-strong)' },
  { name: '부드러운 강조', token: '--color-accent-soft', value: 'var(--color-accent-soft)' },
];

const typeScale = [
  { name: '디스플레이', token: '--text-display', sample: '시스템을 생각합니다' },
  { name: '큰 제목', token: '--text-xl', sample: '디자인의 기준' },
  { name: '작은 제목', token: '--text-lg', sample: '재사용할 수 있는 구성' },
  { name: '본문', token: '--text-base', sample: '읽기 편한 크기와 줄 간격으로 내용을 전달합니다.' },
  { name: '보조 본문', token: '--text-sm', sample: '설명과 부가 정보를 위한 크기입니다.' },
  { name: '레이블', token: '--text-xs', sample: 'CATEGORY · 2026' },
];

const spaces = ['--space-1', '--space-2', '--space-3', '--space-4', '--space-6', '--space-8', '--space-12', '--space-16', '--space-24'];
const sectionLinks = [
  { href: '#principles', label: '원칙' },
  { href: '#colors', label: '색상' },
  { href: '#typography', label: '타이포그래피' },
  { href: '#spacing', label: '공간' },
  { href: '#surfaces', label: '표면' },
  { href: '#components', label: '컴포넌트' },
];
const contextGroups = [
  { label: '안내', items: sectionLinks.slice(0, 1) },
  { label: '토큰', items: sectionLinks.slice(1, 5) },
  { label: '컴포넌트', items: sectionLinks.slice(5) },
];
---
<BaseLayout title="디자인 시스템 — Shaul Kim" description="사이트의 디자인 토큰과 재사용 컴포넌트를 한눈에 살펴봅니다.">
  <Header contextGroups={contextGroups} />
  <main>
    <section class="catalog-hero container">
      <p class="eyebrow">기준과 구성 요소</p>
      <h1>디자인 시스템</h1>
      <p class="intro">사이트 전반에 일관된 인상과 사용성을 만드는 토큰, 원칙, 컴포넌트를 모았습니다. 상단의 테마 버튼으로 모든 항목의 라이트·다크 표현을 함께 확인할 수 있습니다.</p>
    </section>

    <div class="catalog-layout container">
      <aside class="catalog-nav" aria-label="디자인 시스템 목차">
        <p>목차</p>
        <nav>{sectionLinks.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
      </aside>

      <div class="catalog-content">
        <section id="principles" class="catalog-section">
          <p class="eyebrow">01 · 원칙</p>
          <h2>명확하고, 조용하고, 의도적으로</h2>
          <div class="principle-grid">
            <article><span>01</span><h3>내용이 먼저</h3><p>장식보다 글과 프로젝트가 먼저 보이도록 시각적 위계를 만듭니다.</p></article>
            <article><span>02</span><h3>일관된 리듬</h3><p>제한된 공간 단위와 글자 크기로 화면 전체의 리듬을 유지합니다.</p></article>
            <article><span>03</span><h3>접근 가능한 대비</h3><p>두 가지 테마 모두에서 내용과 상태가 명확하게 구분되도록 합니다.</p></article>
          </div>
        </section>

        <section id="colors" class="catalog-section">
          <p class="eyebrow">02 · 토큰</p>
          <h2>색상</h2>
          <p class="section-copy">의미 기반 CSS 사용자 정의 속성을 사용하므로 테마가 바뀌어도 구성 요소의 역할은 유지됩니다.</p>
          <div class="color-grid">
            {colors.map((color) => (
              <article class="color-token">
                <div class="swatch" style={`background: ${color.value}`}></div>
                <div><strong>{color.name}</strong><code>{color.token}</code></div>
              </article>
            ))}
          </div>
        </section>

        <section id="typography" class="catalog-section">
          <p class="eyebrow">03 · 토큰</p>
          <h2>타이포그래피</h2>
          <div class="type-list">
            {typeScale.map((type) => (
              <article><div><strong>{type.name}</strong><code>{type.token}</code></div><p style={`font-size: var(${type.token})`}>{type.sample}</p></article>
            ))}
          </div>
        </section>

        <section id="spacing" class="catalog-section">
          <p class="eyebrow">04 · 토큰</p>
          <h2>공간</h2>
          <p class="section-copy">4px를 시작점으로 한 제한된 간격 체계가 컴포넌트와 페이지의 수직 리듬을 만듭니다.</p>
          <div class="space-list">
            {spaces.map((space) => <div><code>{space}</code><span style={`width: var(${space})`}></span></div>)}
          </div>
        </section>

        <section id="surfaces" class="catalog-section">
          <p class="eyebrow">05 · 토큰</p>
          <h2>표면과 형태</h2>
          <div class="surface-grid">
            <article class="surface-demo radius-sm"><span>작은 반경</span><code>--radius-sm</code></article>
            <article class="surface-demo radius-md"><span>중간 반경</span><code>--radius-md</code></article>
            <article class="surface-demo radius-lg"><span>큰 반경</span><code>--radius-lg</code></article>
            <article class="surface-demo shadow"><span>카드 그림자</span><code>--shadow-card</code></article>
          </div>
        </section>

        <section id="components" class="catalog-section">
          <p class="eyebrow">06 · 구성 요소</p>
          <h2>컴포넌트</h2>
          <div class="component-block">
            <div class="component-title"><div><h3>버튼과 링크</h3><p>행동의 중요도에 따라 채움과 텍스트 표현을 구분합니다.</p></div><code>전역 기본 요소</code></div>
            <div class="button-row"><a class="button primary" href="#components">주요 행동</a><a class="button secondary" href="#components">보조 행동</a><a class="text-link" href="#components">텍스트 링크 →</a></div>
          </div>
          <div class="component-block">
            <div class="component-title"><div><h3>프로젝트 카드</h3><p>프로젝트의 시각 요소, 설명, 연도, 기술을 묶습니다.</p></div><code>ProjectCard.astro</code></div>
            <ProjectCard title="LocalMind" summary="AI가 이전 결정의 맥락을 이어받도록 돕는 개인 지식 시스템입니다." year="2026" stack={['Python', 'MCP', 'Semantic Search']} href="/projects/localmind" />
          </div>
          <div class="component-block">
            <div class="component-title"><div><h3>시리즈 배지</h3><p>연속해서 읽는 글의 소속과 현재 순서를 일반 주제 태그보다 명확하게 표시합니다.</p></div><code>SeriesBadge.astro</code></div>
            <div class="component-row">
              <SeriesBadge label="sdd-5docs" />
              <SeriesBadge label="sdd-5docs" position="6/6" />
              <SeriesBadge label="나의 작업 흐름" position="2/2" />
            </div>
          </div>
          <div class="component-block">
            <div class="component-title"><div><h3>시리즈 필터와 태그</h3><p>전체 글과 시리즈를 전환하고, 각 글이 속한 시리즈를 일반 태그보다 먼저 보여 줍니다. 최신 편을 위에 두고 이전 편은 아래로 이어집니다.</p></div><code>SeriesFilter.astro · PostPreview.astro</code></div>
            <SeriesFilter seriesOptions={['나의 작업 흐름', 'sdd-5docs']} totalCount={8} selected="sdd-5docs" visibleCount={6} />
            <PostPreview
              title="sdd-5docs 6: review.md가 작성되기 전에는 완료가 아니다"
              description="구현 결과와 검수 범위, 실행 증거와 남은 위험을 기록해 완료 선언을 검증 가능한 상태로 만드는 방법."
              publishedAt={new Date('2026-08-08')}
              tags={['작업 흐름', 'SDD', '검증']}
              series="sdd-5docs"
              slug="sdd-5docs-review"
            />
          </div>
          <div class="component-block navigation-component">
            <div class="component-title"><div><h3>글 하단 탐색</h3><p>시리즈 이동과 전체 글 목록을 카드, 구분선, 제한된 간격 토큰으로 구분합니다. 모바일은 카드에서 구분선까지 48px, 링크 위 48px, 페이지 끝까지 64px의 리듬을 사용합니다.</p></div><code>ArticleNavigation.astro</code></div>
            <ArticleNavigation
              next={{ href: '#components', title: '나의 작업 흐름 2: 완료를 증명하고 다음 시작점을 남기는 법' }}
              allPostsHref="#components"
            />
          </div>
          <div class="component-block footer-component">
            <div class="component-title"><div><h3>사이트 푸터</h3><p>짧은 페이지에도 명확한 종료점을 만들고, 사이트의 정체성과 GitHub 작업 공간을 조용한 위계로 연결합니다.</p></div><code>SiteFooter.astro</code></div>
            <SiteFooter />
          </div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  .catalog-hero { padding-block: clamp(5rem, 10vw, 9rem) var(--space-16); border-bottom: 1px solid var(--color-line); }
  h1 { margin: 0; font-family: var(--font-display); font-size: var(--text-display); font-weight: 400; letter-spacing: -.055em; line-height: .95; }
  .intro { max-width: 46rem; margin: var(--space-8) 0 0; color: var(--color-muted); font-size: var(--text-lg); }
  .catalog-layout { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: clamp(2rem, 7vw, 7rem); align-items: start; }
  .catalog-nav { position: sticky; top: var(--space-6); padding-block: var(--space-16); }
  .catalog-nav p { margin: 0 0 var(--space-4); color: var(--color-muted); font-size: var(--text-xs); font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .catalog-nav nav { display: grid; gap: var(--space-2); }
  .catalog-nav a { padding-block: var(--space-1); color: var(--color-muted); font-size: var(--text-sm); font-weight: 700; text-decoration: none; }
  .catalog-nav a:hover { color: var(--color-accent-strong); }
  .catalog-section { padding-block: var(--space-16); scroll-margin-top: var(--space-8); border-bottom: 1px solid var(--color-line); }
  .catalog-section:last-child { border-bottom: 0; }
  h2 { margin: 0; font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; letter-spacing: -.025em; }
  .section-copy { max-width: 44rem; margin: var(--space-4) 0 var(--space-8); color: var(--color-muted); }
  .principle-grid, .surface-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-top: var(--space-8); }
  .principle-grid article { padding: var(--space-6); background: var(--color-surface-raised); border: 1px solid var(--color-line); border-radius: var(--radius-md); }
  .principle-grid span { color: var(--color-accent-strong); font-size: var(--text-xs); font-weight: 800; }
  .principle-grid h3 { margin: var(--space-8) 0 var(--space-2); font-family: var(--font-display); font-size: var(--text-lg); font-weight: 400; }
  .principle-grid p { margin: 0; color: var(--color-muted); font-size: var(--text-sm); }
  .color-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
  .color-token { display: grid; grid-template-columns: 5rem 1fr; align-items: center; overflow: hidden; background: var(--color-surface-raised); border: 1px solid var(--color-line); border-radius: var(--radius-sm); }
  .swatch { align-self: stretch; min-height: 5rem; border-right: 1px solid var(--color-line); }
  .color-token div:last-child { display: grid; gap: var(--space-1); padding: var(--space-4); }
  .color-token strong, .type-list strong { font-size: var(--text-sm); }
  code { color: var(--color-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: var(--text-xs); }
  .type-list { margin-top: var(--space-8); border-top: 1px solid var(--color-line); }
  .type-list article { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--space-6); align-items: baseline; padding-block: var(--space-6); border-bottom: 1px solid var(--color-line); }
  .type-list article > div { display: grid; }
  .type-list p { overflow-wrap: anywhere; margin: 0; line-height: 1.1; }
  .space-list { display: grid; gap: var(--space-3); margin-top: var(--space-8); }
  .space-list div { display: grid; grid-template-columns: 7rem 1fr; gap: var(--space-4); align-items: center; }
  .space-list span { display: block; max-width: 100%; height: 1rem; background: var(--color-accent); border-radius: 99rem; }
  .surface-grid { grid-template-columns: repeat(2, 1fr); }
  .surface-demo { display: grid; min-height: 9rem; align-content: space-between; padding: var(--space-6); background: var(--color-surface-raised); border: 1px solid var(--color-line); }
  .surface-demo span { font-family: var(--font-display); font-size: var(--text-lg); }
  .radius-sm { border-radius: var(--radius-sm); } .radius-md { border-radius: var(--radius-md); } .radius-lg { border-radius: var(--radius-lg); } .shadow { box-shadow: var(--shadow-card); }
  .component-block { padding: var(--space-8); margin-top: var(--space-8); background: color-mix(in srgb, var(--color-surface-raised) 70%, transparent); border: 1px solid var(--color-line); border-radius: var(--radius-lg); }
  .component-title { display: flex; gap: var(--space-6); align-items: start; justify-content: space-between; margin-bottom: var(--space-8); }
  .component-title h3 { margin: 0; font-family: var(--font-display); font-size: var(--text-lg); font-weight: 400; }
  .component-title p { margin: var(--space-1) 0 0; color: var(--color-muted); font-size: var(--text-sm); }
  .empty-component > p { padding: var(--space-6); margin: 0; color: var(--color-muted); background: var(--color-surface-raised); border: 1px dashed var(--color-line); border-radius: var(--radius-md); }
  .component-row { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .button-row { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .button { display: inline-flex; min-height: 2.75rem; align-items: center; padding-inline: var(--space-6); border-radius: 99rem; font-size: var(--text-sm); font-weight: 800; text-decoration: none; }
  .button.primary { color: var(--color-surface); background: var(--color-ink); }
  .button.primary:hover { color: var(--color-surface); background: var(--color-accent-strong); }
  .button.secondary { border: 1px solid var(--color-line); }
  @media (max-width: 48rem) {
    .catalog-layout { grid-template-columns: 1fr; gap: 0; }
    .catalog-nav { display: none; }
    .principle-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 36rem) {
    .color-grid, .surface-grid { grid-template-columns: 1fr; }
    .type-list article { grid-template-columns: 1fr; gap: var(--space-3); }
    .component-block { padding: var(--space-5, 1.25rem); }
    .component-title { display: block; }
    .component-title code { display: inline-block; margin-top: var(--space-3); }
  }
</style>
