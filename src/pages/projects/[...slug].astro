---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projectFacts = project.data.facts ?? ['직접 사용하며 개선 중', '단일 기기 · 선택적 서버', '2026년 시작'];
const projectInitials = project.data.initials ?? project.data.title.slice(0, 2).toUpperCase();
const sectionLinks = [
  { href: '#problem', label: '시작한 이유' },
  { href: '#change', label: '무엇이 달라지나' },
  { href: '#how-it-works', label: '사용 흐름' },
  { href: '#architecture', label: '구조' },
  { href: '#value', label: '가치' },
  { href: '#status', label: '현재 상태' },
];
const contextGroups = [
  { label: '이해하기', items: sectionLinks.slice(0, 2) },
  { label: '작동 방식', items: sectionLinks.slice(2, 4) },
  { label: '프로젝트', items: sectionLinks.slice(4) },
];
---

<BaseLayout title={`${project.data.title} — 프로젝트`} description={project.data.summary}>
  <Header contextGroups={contextGroups} />
  <main>
    <section class="project-hero container">
      <div class="hero-copy">
        <p class="eyebrow">실제 프로젝트 · {project.data.year}</p>
        <h1>{project.data.title}</h1>
        <p class="summary">{project.data.summary}</p>
        <div class="project-facts" aria-label="프로젝트 정보">
          {projectFacts.map((fact) => <span>{fact}</span>)}
        </div>
        {project.data.repository && (
          <a class="source-link" href={project.data.repository} rel="external" aria-label={`${project.data.title} GitHub 저장소 열기`}>
            GitHub에서 프로젝트 소스 보기 <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
      <div class="hero-visual" aria-hidden="true">
        <span class="orbit orbit-one"></span>
        <span class="orbit orbit-two"></span>
        <span class="node node-center">{projectInitials}</span>
        <span class="node node-one"></span>
        <span class="node node-two"></span>
        <span class="node node-three"></span>
      </div>
    </section>

    <article class="project-body container">
      <Content />
    </article>

    <nav class="project-footer container" aria-label="프로젝트 탐색">
      <a href="/projects">← 프로젝트 목록으로</a>
    </nav>
  </main>
</BaseLayout>

<style lang="scss">
  .project-hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .85fr); gap: clamp(3rem, 8vw, 8rem); align-items: center; min-height: min(46rem, 82vh); padding-block: clamp(5rem, 10vw, 9rem); }
  h1 { margin: 0; font-family: var(--font-display); font-size: clamp(4rem, 2.4rem + 7vw, 9rem); font-weight: 400; letter-spacing: -.065em; line-height: .86; }
  .summary { max-width: 42rem; margin: var(--space-8) 0 0; color: var(--color-muted); font-size: var(--text-lg); }
  .project-facts { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-8); }
  .project-facts span { padding: .35rem .75rem; background: var(--color-surface-raised); border: 1px solid var(--color-line); border-radius: 99rem; color: var(--color-muted); font-size: var(--text-xs); font-weight: 700; }
  .source-link { display: inline-flex; gap: var(--space-2); align-items: center; padding: .8rem 1.1rem; margin-top: var(--space-6); color: var(--color-surface); background: var(--color-ink); border-radius: 99rem; font-size: var(--text-sm); font-weight: 800; text-decoration: none; }
  .source-link:hover { color: var(--color-surface); transform: translateY(-1px); }
  .hero-visual { position: relative; aspect-ratio: 1; overflow: hidden; background: var(--color-accent-soft); border: 1px solid var(--color-line); border-radius: 50%; }
  .orbit { position: absolute; inset: 15%; border: 1px solid var(--color-accent); border-radius: 50%; }
  .orbit-two { inset: 30%; border-style: dashed; }
  .node { position: absolute; display: grid; width: 8%; aspect-ratio: 1; place-items: center; background: var(--color-surface-raised); border: 2px solid var(--color-accent-strong); border-radius: 50%; }
  .node-center { inset: 38%; width: 24%; color: var(--color-accent-strong); font-family: var(--font-display); font-size: clamp(1.5rem, 4vw, 3rem); }
  .node-one { top: 12%; left: 46%; }
  .node-two { right: 15%; bottom: 24%; }
  .node-three { bottom: 18%; left: 18%; }
  .project-body { max-width: 72rem; padding-block: var(--space-24); border-top: 1px solid var(--color-line); }
  .project-body :global(.story-section) { padding-block: var(--space-16); scroll-margin-top: 6rem; border-bottom: 1px solid var(--color-line); }
  .project-body :global(.story-section:last-child) { border-bottom: 0; }
  .project-body :global(.section-label) { margin: 0 0 var(--space-3); color: var(--color-accent-strong); font-size: var(--text-xs); font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .project-body :global(h2) { max-width: 48rem; margin: 0; font-family: var(--font-display); font-size: clamp(2.2rem, 1.5rem + 3vw, 4.5rem); font-weight: 400; letter-spacing: -.045em; line-height: 1; }
  .project-body :global(h3) { margin: 0; font-family: var(--font-display); font-size: var(--text-lg); font-weight: 400; }
  .project-body :global(.section-intro) { max-width: 48rem; margin: var(--space-6) 0 0; color: var(--color-muted); font-size: var(--text-lg); }
  .project-body :global(.plain-language) { max-width: 54rem; padding: var(--space-8); margin-top: var(--space-8); background: var(--color-accent-soft); border-left: .3rem solid var(--color-accent-strong); border-radius: 0 var(--radius-md) var(--radius-md) 0; }
  .project-body :global(.plain-language strong) { display: block; margin-bottom: var(--space-2); font-size: var(--text-sm); }
  .project-body :global(.plain-language p) { margin: 0; }
  .project-body :global(.before-after) { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--space-4); align-items: stretch; margin-top: var(--space-10, 2.5rem); }
  .project-body :global(.comparison-card) { padding: var(--space-8); background: var(--color-surface-raised); border: 1px solid var(--color-line); border-radius: var(--radius-lg); }
  .project-body :global(.comparison-card.after) { border-color: var(--color-accent); box-shadow: inset 0 0 0 1px var(--color-accent-soft); }
  .project-body :global(.comparison-card > span) { color: var(--color-muted); font-size: var(--text-xs); font-weight: 800; letter-spacing: .1em; }
  .project-body :global(.comparison-card ul) { display: grid; gap: var(--space-3); padding: 0; margin: var(--space-6) 0 0; list-style: none; }
  .project-body :global(.comparison-card li) { padding: var(--space-3); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-sm); }
  .project-body :global(.comparison-arrow) { display: grid; place-items: center; color: var(--color-accent-strong); font-size: var(--text-xl); }
  .project-body :global(.project-flow) { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-3); margin-top: var(--space-10, 2.5rem); counter-reset: flow; }
  .project-body :global(.flow-step) { position: relative; min-height: 14rem; padding: var(--space-6); background: var(--color-surface-raised); border: 1px solid var(--color-line); border-radius: var(--radius-md); counter-increment: flow; }
  .project-body :global(.flow-step::before) { content: '0' counter(flow); display: block; margin-bottom: var(--space-8); color: var(--color-accent-strong); font-size: var(--text-xs); font-weight: 800; }
  .project-body :global(.flow-step:not(:last-child)::after) { content: '→'; position: absolute; z-index: 1; top: 50%; right: calc(var(--space-3) * -.75); transform: translate(50%, -50%); color: var(--color-accent-strong); font-weight: 800; }
  .project-body :global(.flow-step p) { margin: var(--space-3) 0 0; color: var(--color-muted); font-size: var(--text-sm); }
  .project-body :global(.expansion-path) { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: var(--space-4); align-items: center; margin-top: var(--space-10, 2.5rem); padding: var(--space-5); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-lg); }
  .project-body :global(.expansion-step) { display: grid; gap: var(--space-2); padding: var(--space-4); background: var(--color-surface-raised); border: 1px solid var(--color-line); border-radius: var(--radius-md); }
  .project-body :global(.expansion-step span), .project-body :global(.expansion-step small) { color: var(--color-muted); font-size: var(--text-xs); }
  .project-body :global(.expansion-step strong) { color: var(--color-ink); }
  .project-body :global(.expansion-arrow) { color: var(--color-accent-strong); font-size: var(--text-xs); text-align: center; white-space: nowrap; }
  .project-body :global(.expansion-note) { margin: var(--space-4) 0 0; color: var(--color-muted); }
  .project-body :global(.expansion-note strong) { color: var(--color-ink); }
  .project-body :global(.deployment-modes) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin-top: var(--space-10, 2.5rem); }
  .project-body :global(.deployment-mode) { padding: var(--space-6); background: var(--color-surface-raised); border: 1px solid var(--color-line); border-radius: var(--radius-lg); }
  .project-body :global(.deployment-mode.local-mode) { border-color: var(--color-accent); box-shadow: inset 0 0 0 1px var(--color-accent-soft); }
  .project-body :global(.mode-badge) { display: inline-block; margin-bottom: var(--space-4); color: var(--color-accent-strong); font-size: var(--text-xs); font-weight: 800; letter-spacing: .06em; }
  .project-body :global(.deployment-mode p) { margin: var(--space-3) 0 0; color: var(--color-muted); }
  .project-body :global(.mode-flow) { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr); gap: var(--space-2); align-items: center; margin-top: var(--space-6); }
  .project-body :global(.mode-flow span) { padding: var(--space-2); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-sm); font-size: var(--text-xs); font-weight: 700; text-align: center; }
  .project-body :global(.mode-flow b) { color: var(--color-accent-strong); }
  .project-body :global(.architecture-subtitle) { margin-top: var(--space-16); font-size: clamp(1.5rem, 1.2rem + 1.3vw, 2.25rem); }
  .project-body :global(.architecture-map) { overflow: hidden; margin-top: var(--space-10, 2.5rem); background: var(--color-surface-raised); border: 1px solid var(--color-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  .project-body :global(.architecture-flow) { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1.2fr) auto minmax(0, 1fr); gap: var(--space-3); align-items: stretch; padding: var(--space-6); }
  .project-body :global(.architecture-node) { display: grid; align-content: start; min-width: 0; min-height: 12rem; padding: var(--space-5, 1.25rem); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); }
  .project-body :global(.architecture-node-accent) { background: var(--color-accent-soft); border-color: var(--color-accent); }
  .project-body :global(.architecture-node span) { color: var(--color-accent-strong); font-size: var(--text-xs); font-weight: 800; letter-spacing: .08em; }
  .project-body :global(.architecture-node h4) { margin: var(--space-8) 0 var(--space-3); font-family: var(--font-display); font-size: var(--text-lg); font-weight: 400; line-height: 1.1; }
  .project-body :global(.architecture-node p) { margin: 0; color: var(--color-muted); font-size: var(--text-sm); line-height: 1.65; overflow-wrap: anywhere; }
  .project-body :global(.architecture-connector) { display: grid; gap: var(--space-2); place-content: center; color: var(--color-muted); text-align: center; }
  .project-body :global(.architecture-connector small) { max-width: 4.5rem; font-size: var(--text-xs); line-height: 1.35; }
  .project-body :global(.architecture-connector b) { color: var(--color-accent-strong); font-size: var(--text-lg); }
  .project-body :global(.tool-grid), .project-body :global(.value-grid) { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); margin-top: var(--space-8); }
  .project-body :global(.tool-card), .project-body :global(.value-card) { padding: var(--space-6); background: var(--color-surface-raised); border: 1px solid var(--color-line); border-radius: var(--radius-md); }
  .project-body :global(.tool-card code) { color: var(--color-accent-strong); font-weight: 800; }
  .project-body :global(.tool-card p), .project-body :global(.value-card p) { margin: var(--space-3) 0 0; color: var(--color-muted); }
  .project-body :global(.timeline) { display: grid; gap: 0; padding: 0; margin: var(--space-8) 0 0; list-style: none; }
  .project-body :global(.timeline li) { display: grid; grid-template-columns: 8rem 1fr; gap: var(--space-6); padding-block: var(--space-4); border-top: 1px solid var(--color-line); }
  .project-body :global(.timeline strong) { color: var(--color-accent-strong); }
  .project-body :global(.status-note) { padding: var(--space-6); margin-top: var(--space-8); background: var(--color-surface-raised); border: 1px dashed var(--color-line); border-radius: var(--radius-md); color: var(--color-muted); }
  .project-footer { padding-block: 0 var(--space-24); }
  .project-footer a { font-weight: 800; }
  @media (max-width: 52rem) {
    .project-hero { grid-template-columns: 1fr; min-height: auto; }
    .hero-visual { width: min(70vw, 24rem); }
    .project-body :global(.project-flow) { grid-template-columns: repeat(2, 1fr); }
    .project-body :global(.flow-step:nth-child(2)::after) { display: none; }
  }
  @media (max-width: 38rem) {
    .project-hero { gap: var(--space-10, 2.5rem); }
    .project-body { padding-block: var(--space-12); }
    .project-body :global(.story-section) { padding-block: var(--space-12); }
    .project-body :global(.before-after) { grid-template-columns: 1fr; }
    .project-body :global(.comparison-arrow) { transform: rotate(90deg); }
    .project-body :global(.project-flow), .project-body :global(.tool-grid), .project-body :global(.value-grid), .project-body :global(.deployment-modes), .project-body :global(.expansion-path) { grid-template-columns: 1fr; }
    .project-body :global(.expansion-path) { padding: var(--space-4); }
    .project-body :global(.expansion-arrow) { font-size: 0; white-space: normal; }
    .project-body :global(.expansion-arrow::after) { content: '필요할 때 확장 ↓'; font-size: var(--text-xs); }
    .project-body :global(.architecture-flow-stepper) { grid-template-columns: 1fr; gap: 0; padding: 0; }
    .project-body :global(.architecture-flow-stepper .architecture-node) { display: grid; grid-template-columns: 10% 1fr; min-height: 0; padding: 3vw; background: transparent; border: 0; border-bottom: 1px solid var(--color-line); border-radius: 0; box-shadow: none; }
    .project-body :global(.architecture-flow-stepper .architecture-node-accent) { background: var(--color-accent-soft); }
    .project-body :global(.architecture-flow-stepper .architecture-node:last-child) { border-bottom: 0; }
    .project-body :global(.architecture-flow-stepper .architecture-node span) { grid-row: 1 / 3; align-self: center; font-size: var(--text-xs); letter-spacing: .08em; }
    .project-body :global(.architecture-flow-stepper .architecture-node h4) { grid-column: 2; margin: 0; font-family: var(--font-sans); font-size: var(--text-sm); font-weight: 800; }
    .project-body :global(.architecture-flow-stepper .architecture-node p) { grid-column: 2; margin: var(--space-1) 0 0; font-size: var(--text-xs); line-height: 1.45; }
    .project-body :global(.architecture-flow-stepper .architecture-connector) { min-width: 0; min-height: 1.25rem; gap: 0; padding: 0; }
    .project-body :global(.architecture-flow-stepper .architecture-connector small) { display: none; }
    .project-body :global(.architecture-flow-stepper .architecture-connector b) { font-size: 0; }
    .project-body :global(.architecture-flow-stepper .architecture-connector b::after) { content: '↓'; font-size: var(--text-sm); }
    .project-body :global(.flow-step) { min-height: 0; }
    .project-body :global(.flow-step:not(:last-child)::after) { top: auto; right: 50%; bottom: calc(var(--space-3) * -.75); transform: translate(50%, 50%) rotate(90deg); }
    .project-body :global(.flow-step:nth-child(2)::after) { display: block; }
    .project-body :global(.timeline li) { grid-template-columns: 1fr; gap: var(--space-1); }
  }
  @media (prefers-reduced-motion: reduce) { .orbit { border-style: solid; } }
</style>
