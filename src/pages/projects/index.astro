---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = await getCollection('projects');
---

<BaseLayout title="프로젝트 — Shaul Kim" description="실제로 사용하고 개선하는 프로젝트를 하나씩 소개합니다.">
  <Header />
  <main class="container section">
    <p class="eyebrow">실제로 사용하고 있는 것들</p>
    <h1>프로젝트</h1>
    <p class="intro">예시가 아닌 실제 작업만 기록합니다. 문제를 발견한 이유부터 사용하는 흐름, 현재 상태까지 비개발자도 이해할 수 있도록 설명합니다.</p>
    <div class="project-grid">
      {projects.map(({ data, id }) => <ProjectCard {...data} href={`/projects/${id}`} />)}
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  h1 { margin: 0; font-family: var(--font-display); font-size: var(--text-display); font-weight: 400; letter-spacing: -.04em; }
  .intro { max-width: 42rem; margin: var(--space-4) 0 var(--space-12); color: var(--color-muted); font-size: var(--text-lg); }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }
  @media (max-width: 44rem) { .project-grid { grid-template-columns: 1fr; } }
</style>
