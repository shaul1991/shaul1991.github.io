---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostPreview from '../components/PostPreview.astro';

const projects = (await getCollection('projects')).filter(({ data }) => data.featured);
const posts = (await getCollection('posts')).filter(({ data }) => !data.draft).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Shaul Kim — 개발자이자 만드는 사람">
  <Header />
  <main>
    <section class="hero container">
      <p class="eyebrow">개발 · 만들기 · 기록</p>
      <h1>시스템을 생각하고,<br /><em>의도를 담아 만듭니다.</em></h1>
      <div class="hero-bottom"><p>블로그에는 배우고 만든 과정을 기록하고, 포트폴리오에는 실제로 동작하는 결과물을 모읍니다.</p><a href="#recent-projects">선별한 작업 보기 ↓</a></div>
    </section>
    <section id="recent-projects" class="section container">
      <div class="section-heading"><div><p class="eyebrow">선별한 작업</p><h2>최근 프로젝트</h2></div><a class="text-link" href="/projects">모든 프로젝트 →</a></div>
      <div class="project-grid">{projects.map(({ data }) => <ProjectCard {...data} />)}</div>
    </section>
    <section id="recent-posts" class="section writing"><div class="container"><div class="section-heading"><div><p class="eyebrow">노트에서</p><h2>최근 글</h2></div><a class="text-link" href="/blog">모든 글 →</a></div>{posts.slice(0, 3).map(({ data, id }) => <PostPreview {...data} slug={id} />)}</div></section>
  </main>
  <footer class="container">© {new Date().getFullYear()} Shaul Kim. 의도를 담아 만들었습니다.</footer>
</BaseLayout>
<style lang="scss">
  .hero { padding-block: clamp(7rem, 16vw, 13rem) var(--space-24); } h1 { max-width: 68rem; margin: 0; font-family: var(--font-display); font-size: var(--text-display); font-weight: 400; letter-spacing: -.055em; line-height: .93; } h1 em { color: var(--color-accent-strong); } .hero-bottom { display: flex; gap: var(--space-8); align-items: end; justify-content: space-between; max-width: 68rem; margin-top: var(--space-12); } .hero-bottom p { max-width: 30rem; margin: 0; color: var(--color-muted); } .hero-bottom a { font-size: var(--text-sm); font-weight: 800; white-space: nowrap; } .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); } .writing { background: var(--color-surface-raised); border-block: 1px solid var(--color-line); } footer { padding-block: var(--space-8); color: var(--color-muted); font-size: var(--text-sm); } @media (max-width: 44rem) { .hero-bottom { display: block; } .hero-bottom a { display: inline-block; margin-top: var(--space-6); } .project-grid { grid-template-columns: 1fr; } }
</style>
