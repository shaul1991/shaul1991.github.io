---
interface Props { title: string; summary: string; year: string; stack: string[]; url?: string; }
const { title, summary, year, stack, url } = Astro.props;
---
<article class="project-card">
  <div class="project-art" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="project-content">
    <div class="project-meta"><span>{year}</span><span>{stack.slice(0, 2).join(' · ')}</span></div>
    <h3>{url ? <a href={url}>{title} <span>↗</span></a> : title}</h3>
    <p>{summary}</p>
    <ul aria-label={`${title} 사용 기술`}>{stack.map((item) => <li>{item}</li>)}</ul>
  </div>
</article>
<style lang="scss">
  .project-card { overflow: hidden; display: grid; grid-template-columns: minmax(10rem, .8fr) 1.2fr; background: var(--color-surface-raised); border: 1px solid var(--color-line); border-radius: var(--radius-md); transition: transform .25s var(--ease-out), box-shadow .25s var(--ease-out); }
  .project-card:hover { transform: translateY(-.3rem); box-shadow: var(--shadow-card); }
  .project-art { position: relative; min-height: 15rem; overflow: hidden; background: var(--color-accent-soft); }
  .project-art span { position: absolute; border: 1px solid var(--color-accent); border-radius: 50%; }
  .project-art span:nth-child(1) { width: 12rem; height: 12rem; top: 12%; left: -28%; }
  .project-art span:nth-child(2) { width: 7rem; height: 7rem; right: -15%; bottom: 6%; background: var(--color-accent); }
  .project-art span:nth-child(3) { width: 2rem; height: 2rem; top: 28%; right: 24%; background: var(--color-surface-raised); }
  .project-content { padding: var(--space-6); }
  .project-meta { display: flex; justify-content: space-between; gap: var(--space-3); color: var(--color-muted); font-size: var(--text-xs); font-weight: 700; }
  h3 { margin: var(--space-4) 0 var(--space-2); font-family: var(--font-display); font-size: var(--text-lg); font-weight: 400; }
  h3 a { text-decoration: none; } h3 span { color: var(--color-accent); }
  p { margin: 0; color: var(--color-muted); font-size: var(--text-sm); }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-2); padding: 0; margin: var(--space-6) 0 0; list-style: none; }
  li { padding: .18rem .55rem; border: 1px solid var(--color-line); border-radius: 99rem; color: var(--color-muted); font-size: var(--text-xs); }
  @media (max-width: 38rem) { .project-card { grid-template-columns: 1fr; } .project-art { min-height: 8rem; } }
</style>
