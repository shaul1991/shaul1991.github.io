---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-intro">
      <strong>Shaul Kim</strong>
      <p>실제 프로젝트와 작업 과정을 기록합니다.</p>
    </div>

    <nav aria-label="하단 탐색">
      <a href="https://github.com/shaul1991" target="_blank" rel="noreferrer">
        GitHub에서 작업 보기 <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <p class="footer-copyright">© {year} Shaul Kim</p>
  </div>
</footer>

<style lang="scss">
  .site-footer { color: var(--color-ink); }
  .footer-inner {
    display: grid;
    grid-template-areas:
      'intro action'
      'copyright copyright';
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-line);
  }
  .footer-intro { display: grid; grid-area: intro; gap: var(--space-2); }
  .footer-intro strong {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
  }
  .footer-intro p, .footer-copyright { margin: 0; color: var(--color-muted); font-size: var(--text-sm); }
  nav { grid-area: action; }
  nav a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    font-size: var(--text-sm);
    font-weight: 800;
    text-decoration: none;
  }
  nav span { color: var(--color-accent-strong); }
  .footer-copyright { grid-area: copyright; margin-top: var(--space-8); font-size: var(--text-xs); }

  @media (max-width: 38rem) {
    .footer-inner {
      grid-template-areas:
        'intro'
        'action'
        'copyright';
      grid-template-columns: 1fr;
    }
    nav { margin-top: var(--space-6); }
    .footer-copyright { margin-top: var(--space-8); }
  }
</style>
