---
interface Props { title: string; description: string; publishedAt: Date; tags: string[]; slug: string; series?: string; }
const { title, description, publishedAt, tags, slug, series } = Astro.props;
const date = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' }).format(publishedAt);
---
<article class="post-preview">
  <div><p>{date}</p><h3><a href={`/blog/${slug}`}>{title}</a></h3><p class="description">{description}</p></div>
  <div class="tags">
    {series && <span class="series-tag">시리즈 · {series}</span>}
    {tags.map((tag) => <span>#{tag}</span>)}
  </div>
</article>
<style lang="scss">
  .post-preview { display: flex; gap: var(--space-6); align-items: end; justify-content: space-between; padding-block: var(--space-6); border-top: 1px solid var(--color-line); }
  p { margin: 0; color: var(--color-muted); font-size: var(--text-sm); } h3 { margin: var(--space-2) 0; font-family: var(--font-display); font-size: var(--text-lg); font-weight: 400; } h3 a { text-decoration: none; } .description { max-width: 44rem; } .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); justify-content: end; align-items: center; color: var(--color-accent-strong); font-size: var(--text-xs); font-weight: 700; } .series-tag { padding: var(--space-1) var(--space-2); background: var(--color-accent-soft); border: 1px solid var(--color-accent); border-radius: 99rem; white-space: nowrap; } @media (max-width: 38rem) { .post-preview { display: block; } .tags { margin-top: var(--space-4); justify-content: start; } }
</style>
