---
interface Props {
  seriesOptions: string[];
  totalCount: number;
  selected?: string;
  visibleCount?: number;
}

const {
  seriesOptions,
  totalCount,
  selected = 'all',
  visibleCount = selected === 'all' ? totalCount : totalCount,
} = Astro.props;
const statusText = selected === 'all' ? `전체 ${visibleCount}편` : `${selected} 시리즈 ${visibleCount}편`;
---

<section class="series-filter-panel" aria-label="시리즈 필터">
  <div class="filter-heading">
    <span>시리즈</span>
    <p data-series-status aria-live="polite">{statusText}</p>
  </div>
  <div class="series-filters">
    <button type="button" data-series-filter="all" aria-pressed={selected === 'all'}>전체</button>
    {seriesOptions.map((series) => (
      <button type="button" data-series-filter={series} aria-pressed={selected === series}>{series}</button>
    ))}
  </div>
</section>

<style lang="scss">
  .series-filter-panel { padding-block: var(--space-3); border-block: 1px solid var(--color-line); }
  .filter-heading { display: flex; gap: var(--space-6); align-items: baseline; justify-content: space-between; }
  .filter-heading > span { color: var(--color-muted); font-size: var(--text-xs); font-weight: 800; letter-spacing: .08em; }
  [data-series-status] { margin: 0; color: var(--color-muted); font-size: var(--text-xs); }
  .series-filters { display: flex; flex-wrap: wrap; gap: 0 var(--space-5); align-items: center; margin-top: var(--space-1); }
  .series-filters button { min-height: 2.75rem; padding: 0; color: var(--color-muted); background: transparent; border: 0; border-bottom: 2px solid transparent; font: inherit; font-size: var(--text-sm); font-weight: 700; cursor: pointer; }
  .series-filters button:hover { color: var(--color-ink); }
  .series-filters button[aria-pressed='true'] { color: var(--color-ink); border-bottom-color: var(--color-accent-strong); }
  .series-filters button:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }
</style>
