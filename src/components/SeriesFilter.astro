---
interface Props {
  seriesOptions: string[];
  totalCount: number;
  selected?: string;
  visibleCount?: number;
}

const {
  seriesOptions,
  totalCount,
  selected = 'all',
  visibleCount = selected === 'all' ? totalCount : totalCount,
} = Astro.props;
const statusText = selected === 'all' ? `전체 ${visibleCount}편` : `${selected} 시리즈 ${visibleCount}편`;
---

<section class="series-filter-panel" aria-label="시리즈 필터">
  <div class="series-filters">
    <span>시리즈</span>
    <button type="button" data-series-filter="all" aria-pressed={selected === 'all'}>전체</button>
    {seriesOptions.map((series) => (
      <button type="button" data-series-filter={series} aria-pressed={selected === series}>{series}</button>
    ))}
  </div>
  <p data-series-status aria-live="polite">{statusText}</p>
</section>

<style lang="scss">
  .series-filter-panel { display: flex; gap: var(--space-6); align-items: center; justify-content: space-between; padding-block: var(--space-4); border-block: 1px solid var(--color-line); }
  .series-filters { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .series-filters > span { margin-right: var(--space-2); color: var(--color-muted); font-size: var(--text-xs); font-weight: 800; letter-spacing: .08em; }
  .series-filters button { padding: var(--space-2) var(--space-3); color: var(--color-muted); background: transparent; border: 1px solid var(--color-line); border-radius: 99rem; font: inherit; font-size: var(--text-sm); font-weight: 700; cursor: pointer; }
  .series-filters button:hover { color: var(--color-ink); border-color: var(--color-accent); }
  .series-filters button[aria-pressed='true'] { color: var(--color-ink); background: var(--color-accent-soft); border-color: var(--color-accent-strong); }
  [data-series-status] { flex: 0 0 auto; margin: 0; color: var(--color-muted); font-size: var(--text-xs); }
  @media (max-width: 38rem) {
    .series-filter-panel { display: block; }
    [data-series-status] { margin-top: var(--space-3); }
  }
</style>
