---
interface NavigationItem {
  href: string;
  title: string;
}

interface Props {
  previous?: NavigationItem;
  next?: NavigationItem;
  allPostsHref?: string;
}

const { previous, next, allPostsHref = '/blog' } = Astro.props;
---

<div class="article-navigation">
  {(previous || next) && (
    <div class="series-shell container">
      <nav class="series-nav" aria-label="시리즈 글 이동">
        {previous && (
          <a class="previous" href={previous.href}>
            <small>이전 글</small>
            <strong>{previous.title}</strong>
          </a>
        )}
        {next && (
          <a class="next" href={next.href}>
            <small>다음 글</small>
            <strong>{next.title}</strong>
          </a>
        )}
      </nav>
    </div>
  )}
  <footer class="article-footer container">
    <a href={allPostsHref}>← 모든 글 보기</a>
  </footer>
</div>

<style lang="scss">
  .series-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    max-width: 50rem;
    padding-bottom: var(--space-16);
    margin-inline: auto;
  }
  .series-nav a {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-6);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    text-decoration: none;
  }
  .series-nav small {
    color: var(--color-accent-strong);
    font-size: var(--text-xs);
    font-weight: 800;
  }
  .series-nav strong {
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.25;
  }
  .series-nav .next {
    grid-column: 2;
    text-align: right;
  }
  .article-footer {
    padding-block: var(--space-12) var(--space-24);
    border-top: 1px solid var(--color-line);
  }
  .article-footer a { font-weight: 800; }

  @media (max-width: 38rem) {
    .series-nav {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding-bottom: var(--space-12);
    }
    .series-nav a { gap: var(--space-1); padding: var(--space-4); }
    .series-nav strong { font-size: var(--text-base); line-height: 1.4; }
    .series-nav .next { grid-column: auto; text-align: left; }
    .article-footer { padding-block: var(--space-12) var(--space-16); }
  }
</style>
