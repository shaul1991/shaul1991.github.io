{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Evidence-first dark portfolio system for clear, credible technical storytelling.",
  "color": {
    "$type": "color",
    "canvas": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.035,
          0.039,
          0.051
        ],
        "hex": "#090a0d"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.067,
          0.075,
          0.098
        ],
        "hex": "#111319"
      }
    },
    "surface-raised": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.102,
          0.133
        ],
        "hex": "#171a22"
      }
    },
    "text-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.957,
          0.961,
          0.969
        ],
        "hex": "#f4f5f7"
      }
    },
    "text-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.663,
          0.686,
          0.741
        ],
        "hex": "#a9afbd"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.455,
          0.486,
          0.549
        ],
        "hex": "#747c8c"
      }
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.545,
          0.553,
          1
        ],
        "hex": "#8b8dff"
      }
    },
    "accent-strong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.682,
          0.69,
          1
        ],
        "hex": "#aeb0ff"
      }
    },
    "info": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.388,
          0.702,
          1
        ],
        "hex": "#63b3ff"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.31,
          0.82,
          0.647
        ],
        "hex": "#4fd1a5"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.478,
          0.565
        ],
        "hex": "#ff7a90"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 96,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 4,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.04,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 650,
        "letterSpacing": {
          "value": -0.025,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-monospace",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.06,
          "unit": "em"
        }
      }
    }
  }
}
